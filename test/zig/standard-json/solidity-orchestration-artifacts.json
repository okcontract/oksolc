      "content": "// SPDX-License-Identifier: UNLICENSED\npragma solidity 0.8.36;\ncontract Artifacts {\n    uint256 public immutable stored;\n    constructor() { stored = 7; }\n    function ping(uint256 value) external view returns (uint256) { return helper(value) + stored; }\n    function helper(uint256 value) internal pure returns (uint256) { return value + 1; }\n    fallback() external {}\n}\n"
