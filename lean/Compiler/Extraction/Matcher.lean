import Compiler.Extraction.Control
import Compiler.Algebraic.Rules

namespace Compiler.Algebraic
open Contract.Yul

-- Generated by lean/extract_compiler.py from actual Zig function bodies.
-- Source SHA-256: d2c488ec16a8dcd03b89c992a1f4e0a21c998184a84d94aef65d0cd0781ee3fa
-- apply is extracted separately in Construction.lean.
def zigMatches (guard : Guard) (facts : Facts) : Bool :=
  (match guard with | .left_zero => (facts.left == (some 0)) | .right_zero => (facts.right == (some 0)) | .left_one => (facts.left == (some 1)) | .right_one => (facts.right == (some 1)) | .left_max => (facts.left == (some (BitVec.allOnes 256))) | .right_max => (facts.right == (some (BitVec.allOnes 256))) | .equal => facts.equal)

def zigSelectFrom (rules : List Rule) (instruction : BitVec 8)
    (stage : Stage) (facts : Facts) : Option Replacement :=
  (let z_opcode := instruction; (firstReturn rules (fun z_rule => (if ((productionOpcode z_rule.op) == z_opcode) then (let z_rule_stage : Stage := (if (z_rule.guard == .equal) then .equal else .constants); (if ((stage == z_rule_stage) && (zigMatches z_rule.guard facts)) then (some z_rule.replacement) else none)) else none)) none))

def zigSelect := zigSelectFrom productionRules

end Compiler.Algebraic
